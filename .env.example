# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets. .env.local is gitignored.

# MongoDB Atlas connection string.
# In prod, prefer an IP allowlist + a per-environment DB user with least privilege.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/DB?retryWrites=true&w=majority
MONGODB_DB=church-at-the-stadiums

# The canonical URL for this deployment. In prod this must be https.
NEXTAUTH_URL=http://localhost:3000

# 32+ bytes of random base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate this on any suspected leak. Rotation invalidates every active session.
NEXTAUTH_SECRET=replace-me

# ----- Sprint 2 additions -----

# Resend API key (https://resend.com). Without this, emails are only printed
# to the server console (dev fallback).
RESEND_API_KEY=
# Optional: override the From address used for all outbound mail.
EMAIL_FROM=Church at the Stadiums <no-reply@yourdomain.org>

# Vercel Blob read/write token for file uploads. Without this, files land under
# public/uploads/ (fine for dev, useless on a stateless deploy).
BLOB_READ_WRITE_TOKEN=

# Shared secret for cron endpoints (/api/cron/*). Vercel Cron also recognised.
CRON_SECRET=

# Feature flags. Default (unset) is "true"; set to "false" to disable email
# verification: new signups are marked verified at creation, the verify link
# is not sent, and the verified-only gate is bypassed.
EMAIL_VERIFICATION_ENABLED=true
