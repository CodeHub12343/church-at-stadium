{
  "name": "church-at-the-stadiums",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:ping": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/ping-db.ts",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/seed.ts",
    "db:promote": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/promote.ts",
    "db:clear": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/clearSeedData.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.12.1",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "6.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "5.1.34",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "5.4.5"
  }
}
